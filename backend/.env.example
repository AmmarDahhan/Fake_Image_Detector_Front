# Copy to .env and adjust as needed. Every value below is optional - the
# defaults shown are what the backend uses when the variable is absent.

# --- Server ---
# Used by `python -m app.main`. The `uvicorn` CLI takes its bind address
# from its own --host/--port flags instead.
API_HOST=127.0.0.1
API_PORT=8000

# --- Upload validation ---
# Mirrors the frontend's 15 MB limit (frontend/core/config.py and
# .streamlit/config.toml). The backend validates this itself and does not
# trust the client.
MAX_UPLOAD_MB=15

# Accepted formats, comma-separated. Must stay in step with the frontend.
# ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,gif,bmp
# ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,image/bmp

# --- Model ---
# By default the backend loads the reconstructed checkpoint at
#     backend/artifacts/best_accuracy_model.pth
# relative to the project root - no absolute path is hardcoded in the code.
#
# That file is produced from the AI team's extracted archive by:
#     cd backend && python tools/prepare_checkpoint.py
# which re-zips ai_model/best_accuracy_model/ byte-for-byte into a single
# loadable .pth without modifying the AI team's files. Run it once after
# cloning; it is not committed.
#
# MODEL_PATH: point at a different checkpoint (absolute, or relative to the
# process working directory). Leave unset to use the default above.
# MODEL_PATH=

# MODEL_DEVICE: "cpu" or "cuda". Leave unset to auto-detect - CUDA when a CUDA
# device is available, CPU otherwise. Setting "cuda" on a machine without one
# is a hard error (503), never a silent downgrade.
# MODEL_DEVICE=
